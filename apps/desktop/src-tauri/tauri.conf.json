{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TGCloud",
  "version": "1.0.0",
  "identifier": "com.tgcloud.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "TGCloud — Telegram Cloud Storage",
        "width": 1366,
        "height": 860,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "decorations": true,
        "backgroundColor": "#0f141c"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}
